<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearanceOverlay_Blbl_Circular">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay_Blbl_Rounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.Blbl.TopUtilityButton" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:stateListAnimator">@animator/blbl_focus_scale</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">?attr/blblAccentWeak</item>
        <item name="strokeColor">?attr/blblFocusStrokeFocusOnlyColor</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="ThemeOverlay.Blbl.Accent.DarkSoftPink" parent="ThemeOverlay.MaterialComponents">
        <item name="blblAccent">@color/blbl_accent_dark_soft_pink</item>
        <item name="blblAccentContainer">@color/blbl_accent_dark_soft_pink_container</item>
        <item name="blblAccentWeak">@color/blbl_accent_dark_soft_pink_weak</item>
        <item name="blblAccentPressed">@color/blbl_accent_dark_soft_pink_pressed</item>
        <item name="blblFocusStrokeColor">@color/blbl_focus_stroke_dark_soft_pink</item>
        <item name="blblFocusStrokeFocusOnlyColor">@color/blbl_focus_stroke_focus_only_dark_soft_pink</item>
        <item name="colorOnSecondary">@color/blbl_on_dark_soft_pink</item>
    </style>

    <style name="ThemeOverlay.Blbl.Accent.DarkGlass" parent="ThemeOverlay.MaterialComponents">
        <item name="android:colorBackground">@color/blbl_bg_dark_glass</item>
        <item name="colorBackground">@color/blbl_bg_dark_glass</item>
        <item name="blblPageBackdrop">@color/blbl_bg_dark_glass</item>
        <item name="blblContentBackground">@color/blbl_bg_dark_glass</item>
        <item name="colorSurface">@color/blbl_surface_dark_glass</item>
        <item name="blblDialogSurface">@color/blbl_surface_dark_glass</item>
        <item name="colorOnSurface">@color/blbl_text_dark_glass</item>
        <item name="blblOnPageBackdrop">@color/blbl_text_dark_glass</item>
        <item name="blblOnPageBackdropSecondary">@color/blbl_text_secondary_dark_glass</item>
        <item name="android:textColorPrimary">@color/blbl_text_dark_glass</item>
        <item name="android:textColorSecondary">@color/blbl_text_secondary_dark_glass</item>
        <item name="colorPrimary">@color/blbl_surface_dark_glass</item>
        <item name="colorPrimaryVariant">@color/blbl_surface_dark_glass</item>
        <item name="colorOnPrimary">@color/blbl_text_dark_glass</item>
        <item name="colorSecondary">@color/blbl_glass_accent</item>
        <item name="colorOnSecondary">@color/blbl_glass_focus_text</item>
        <item name="colorControlActivated">@color/blbl_glass_accent</item>
        <item name="colorControlHighlight">@color/blbl_glass_accent_container</item>
        <item name="android:statusBarColor">@color/blbl_bg_dark_glass</item>
        <item name="android:navigationBarColor">@color/blbl_bg_dark_glass</item>
        <item name="android:windowBackground">@color/blbl_bg_dark_glass</item>
        <item name="blblAccent">@color/blbl_glass_accent</item>
        <item name="blblAccentContainer">@color/blbl_glass_accent_container</item>
        <item name="blblAccentWeak">@color/blbl_glass_accent_weak</item>
        <item name="blblAccentPressed">@color/blbl_glass_accent_pressed</item>
        <item name="blblNavigationSelectedBackground">@color/blbl_glass_focus</item>
        <item name="blblNavigationSelectedText">@color/blbl_glass_focus_text</item>
        <item name="blblNavigationFocusBackground">@color/blbl_glass_focus</item>
        <item name="blblNavigationFocusText">@color/blbl_glass_focus_text</item>
        <item name="blblFocusBgRound">@drawable/blbl_focus_bg_round_dark_glass</item>
        <item name="blblFocusListSelectorRound">@drawable/blbl_focus_list_selector_round_dark_glass</item>
        <item name="blblFocusStrokeColor">@color/blbl_focus_stroke_dark_glass</item>
        <item name="blblFocusStrokeFocusOnlyColor">@color/blbl_focus_stroke_focus_only_dark_glass</item>
    </style>

    <style name="ThemeOverlay.Blbl.Accent.Violet" parent="ThemeOverlay.MaterialComponents">
        <item name="blblAccent">@color/blbl_purple</item>
        <item name="blblAccentContainer">@color/blbl_accent_violet_container</item>
        <item name="blblAccentWeak">@color/blbl_accent_violet_weak</item>
        <item name="blblAccentPressed">@color/blbl_accent_violet_pressed</item>
    </style>

    <style name="ThemeOverlay.Blbl.Accent.TvPink" parent="ThemeOverlay.MaterialComponents">
        <item name="blblAccent">@color/blbl_accent_tv_pink</item>
        <item name="blblAccentContainer">@color/blbl_accent_tv_pink_container</item>
        <item name="blblAccentWeak">@color/blbl_accent_tv_pink_weak</item>
        <item name="blblAccentPressed">@color/blbl_accent_tv_pink_pressed</item>
    </style>

    <style name="ThemeOverlay.Blbl.Accent.Classic" parent="ThemeOverlay.MaterialComponents">
        <item name="blblAccent">@color/blbl_accent_classic</item>
        <item name="blblAccentContainer">@color/blbl_accent_classic_container</item>
        <item name="blblAccentWeak">@color/blbl_accent_classic_weak</item>
        <item name="blblAccentPressed">@color/blbl_accent_classic_pressed</item>
    </style>

    <style name="ThemeOverlay.Blbl.TransparentDialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="ThemeOverlay.Blbl.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">?attr/blblAccent</item>
        <item name="colorSurface">?attr/blblDialogSurface</item>
        <item name="colorOnPrimary">?attr/colorOnSurface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.Blbl.MaterialAlertDialog.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.Blbl.MaterialAlertDialog.Body.Text</item>
        <!-- For single-choice dialogs (ListView in AlertDialog): inject via listViewStyle for reliability. -->
        <item name="android:listViewStyle">@style/Widget.Blbl.Dialog.ListView</item>
        <item name="android:dropDownListViewStyle">@style/Widget.Blbl.Dialog.ListView</item>
    </style>

    <style name="ThemeOverlay.Blbl.Player.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/blbl_blue</item>
        <item name="colorOnPrimary">@color/blbl_text</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.Blbl.MaterialAlertDialog.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.Blbl.MaterialAlertDialog.Body.Text</item>
        <!-- Player is frozen: keep the old list selector/focus behavior. -->
        <item name="android:listViewStyle">@style/Widget.Blbl.Dialog.ListView</item>
        <item name="android:dropDownListViewStyle">@style/Widget.Blbl.Dialog.ListView</item>
    </style>

    <style name="Widget.Blbl.Dialog.ListView" parent="Widget.AppCompat.ListView">
        <item name="android:listSelector">?attr/blblFocusListSelectorRound</item>
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:cacheColorHint">@android:color/transparent</item>
    </style>

    <style name="Widget.Blbl.MaterialAlertDialog.Title.Text" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Blbl.MaterialAlertDialog.Body.Text" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="TextAppearance.Blbl.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">21sp</item>
    </style>

    <style name="TextAppearance.Blbl.SectionTab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Blbl.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.Blbl.Tab</item>
        <item name="tabIndicator">@drawable/blbl_tab_indicator</item>
        <item name="tabIndicatorColor">?attr/blblAccent</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabBackground">?attr/blblFocusBgRound</item>
        <item name="tabSelectedTextColor">?attr/blblOnPageBackdrop</item>
        <item name="tabTextColor">?attr/blblOnPageBackdropSecondary</item>
        <item name="tabPaddingTop">4dp</item>
        <item name="tabPaddingBottom">2dp</item>
    </style>

    <style name="Widget.Blbl.SectionTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.Blbl.SectionTab</item>
        <item name="tabIndicator">@null</item>
        <item name="tabIndicatorColor">@android:color/transparent</item>
        <item name="tabBackground">@drawable/blbl_section_tab_background</item>
        <item name="tabTextColor">@color/blbl_section_tab_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="tabPaddingStart">16dp</item>
        <item name="tabPaddingEnd">16dp</item>
        <item name="tabPaddingTop">0dp</item>
        <item name="tabPaddingBottom">0dp</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabGravity">start</item>
    </style>

    <!-- Player OSD sizing overlay: baseline values (scaled at runtime by userScale + autoScale). -->
    <style name="ThemeOverlay.Blbl.PlayerOsd.Normal" parent="ThemeOverlay.MaterialComponents">
        <item name="playerOsdButtonTargetSize">@dimen/player_osd_button_target_size</item>
        <item name="playerOsdPadTransport">@dimen/player_osd_pad_transport</item>
        <item name="playerOsdPadNormal">@dimen/player_osd_pad_normal</item>
        <item name="playerOsdPadSmall">@dimen/player_osd_pad_small</item>
        <item name="playerOsdGap">@dimen/player_osd_gap</item>
    </style>
    <style name="Widget.Blbl.MyAction" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/blblOnPageBackdrop</item>
        <item name="android:background">?attr/blblFocusBgRound</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/blbl_focus_scale</item>
    </style>

    <!-- My-page shortcuts: same pill shape, icon+label typography and focus colors as the sidebar. -->
    <style name="Widget.Blbl.MyActionButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/blbl_my_action_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/blbl_focus_scale</item>
        <item name="backgroundTint">@color/blbl_my_action_bg</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">?attr/blblFocusStrokeFocusOnlyColor</item>
        <item name="rippleColor">?attr/blblAccentWeak</item>
        <item name="iconSize">22dp</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">12dp</item>
        <item name="iconTint">@color/blbl_my_action_content</item>
    </style>
</resources>
