<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="8dp"
    android:insetTop="3dp"
    android:insetRight="8dp"
    android:insetBottom="3dp">
    <selector>
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/blbl_glass_accent_pressed" />
                <corners android:radius="10dp" />
            </shape>
        </item>
        <item android:state_focused="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/blbl_glass_focus_fill" />
                <stroke android:width="2dp" android:color="@color/blbl_glass_focus_stroke" />
                <corners android:radius="10dp" />
            </shape>
        </item>
        <item android:state_selected="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/blbl_glass_selected" />
                <corners android:radius="10dp" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="#00000000" />
                <corners android:radius="10dp" />
            </shape>
        </item>
    </selector>
</inset>
