<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblContentBackground">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/overview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="28dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/account_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <!-- 哔哩哔哩 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">
                        <TextView
                            android:layout_width="184dp"
                            android:layout_height="wrap_content"
                            android:text="@string/platform_bilibili"
                            android:textColor="?attr/blblOnPageBackdrop"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-medium" />
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/account_bilibili"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:nextFocusDown="@id/account_iqiyi"
                            android:nextFocusRight="@id/remove_bilibili"
                            android:stateListAnimator="@animator/blbl_focus_scale"
                            app:cardBackgroundColor="@color/blbl_my_account_card_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:rippleColor="?attr/blblAccentWeak">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp">
                                <FrameLayout
                                    android:layout_width="52dp"
                                    android:layout_height="52dp">
                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/logo_bilibili"
                                        android:layout_width="52dp"
                                        android:layout_height="52dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/ic_platform_bilibili"
                                        android:contentDescription="@string/platform_bilibili"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_Blbl_Circular" />
                                    <ImageView
                                        android:id="@+id/vip_bilibili"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="bottom|end"
                                        android:src="@drawable/ic_vip_badge"
                                        android:contentDescription="@string/vip_badge_description"
                                        android:visibility="gone" />
                                </FrameLayout>
                                <TextView
                                    android:id="@+id/name_bilibili"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/mango_account_logged_out"
                                    android:textColor="@color/blbl_my_account_primary"
                                    android:textSize="18sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/remove_bilibili"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:nextFocusLeft="@id/account_bilibili"
                            android:nextFocusDown="@id/remove_iqiyi"
                            android:stateListAnimator="@animator/blbl_focus_scale"
                            app:cardBackgroundColor="@color/blbl_my_account_card_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:rippleColor="?attr/blblAccentWeak">
                            <ImageView
                                android:id="@+id/remove_bilibili_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_platform_remove"
                                android:tint="?attr/blblDanger"
                                android:contentDescription="@string/account_logout_action" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"
                        android:alpha="0.14"
                        android:background="?attr/blblOnPageBackdropSecondary" />

                    <!-- 爱奇艺 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">
                        <TextView
                            android:layout_width="184dp"
                            android:layout_height="wrap_content"
                            android:text="@string/platform_iqiyi"
                            android:textColor="?attr/blblOnPageBackdrop"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-medium" />
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/account_iqiyi"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:nextFocusUp="@id/account_bilibili"
                            android:nextFocusDown="@id/account_mango"
                            android:nextFocusRight="@id/remove_iqiyi"
                            android:stateListAnimator="@animator/blbl_focus_scale"
                            app:cardBackgroundColor="@color/blbl_my_account_card_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:rippleColor="?attr/blblAccentWeak">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp">
                                <FrameLayout
                                    android:layout_width="52dp"
                                    android:layout_height="52dp">
                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/logo_iqiyi"
                                        android:layout_width="52dp"
                                        android:layout_height="52dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/ic_platform_iqiyi"
                                        android:contentDescription="@string/platform_iqiyi"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_Blbl_Circular" />
                                    <ImageView
                                        android:id="@+id/vip_iqiyi"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="bottom|end"
                                        android:src="@drawable/ic_vip_badge"
                                        android:contentDescription="@string/vip_badge_description"
                                        android:visibility="gone" />
                                </FrameLayout>
                                <TextView
                                    android:id="@+id/name_iqiyi"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/mango_account_logged_out"
                                    android:textColor="@color/blbl_my_account_primary"
                                    android:textSize="18sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/remove_iqiyi"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:nextFocusLeft="@id/account_iqiyi"
                            android:nextFocusUp="@id/remove_bilibili"
                            android:nextFocusDown="@id/remove_mango"
                            android:stateListAnimator="@animator/blbl_focus_scale"
                            app:cardBackgroundColor="@color/blbl_my_account_card_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:rippleColor="?attr/blblAccentWeak">
                            <ImageView
                                android:id="@+id/remove_iqiyi_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_platform_remove"
                                android:tint="?attr/blblDanger"
                                android:contentDescription="@string/account_logout_action" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"
                        android:alpha="0.14"
                        android:background="?attr/blblOnPageBackdropSecondary" />

                    <!-- 芒果 TV -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">
                        <TextView
                            android:layout_width="184dp"
                            android:layout_height="wrap_content"
                            android:text="@string/platform_mango"
                            android:textColor="?attr/blblOnPageBackdrop"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-medium" />
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/account_mango"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:nextFocusUp="@id/account_iqiyi"
                            android:nextFocusDown="@id/account_tencent"
                            android:nextFocusRight="@id/remove_mango"
                            android:stateListAnimator="@animator/blbl_focus_scale"
                            app:cardBackgroundColor="@color/blbl_my_account_card_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:rippleColor="?attr/blblAccentWeak">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp">
                                <FrameLayout
                                    android:layout_width="52dp"
                                    android:layout_height="52dp">
                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/logo_mango"
                                        android:layout_width="52dp"
                                        android:layout_height="52dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/ic_platform_mango"
                                        android:contentDescription="@string/platform_mango"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_Blbl_Circular" />
                                    <ImageView
                                        android:id="@+id/vip_mango"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="bottom|end"
                                        android:src="@drawable/ic_vip_badge"
                                        android:contentDescription="@string/vip_badge_description"
                                        android:visibility="gone" />
                                </FrameLayout>
                                <TextView
                                    android:id="@+id/name_mango"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/mango_account_logged_out"
                                    android:textColor="@color/blbl_my_account_primary"
                                    android:textSize="18sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/remove_mango"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:nextFocusLeft="@id/account_mango"
                            android:nextFocusUp="@id/remove_iqiyi"
                            android:nextFocusDown="@id/remove_tencent"
                            android:stateListAnimator="@animator/blbl_focus_scale"
                            app:cardBackgroundColor="@color/blbl_my_account_card_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:rippleColor="?attr/blblAccentWeak">
                            <ImageView
                                android:id="@+id/remove_mango_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_platform_remove"
                                android:tint="?attr/blblDanger"
                                android:contentDescription="@string/account_logout_action" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"
                        android:alpha="0.14"
                        android:background="?attr/blblOnPageBackdropSecondary" />

                    <!-- 腾讯视频（本轮仅占位） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">
                        <TextView
                            android:layout_width="184dp"
                            android:layout_height="wrap_content"
                            android:text="@string/platform_tencent"
                            android:textColor="?attr/blblOnPageBackdrop"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-medium" />
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/account_tencent"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:nextFocusUp="@id/account_mango"
                            android:nextFocusDown="@id/btn_history"
                            android:stateListAnimator="@animator/blbl_focus_scale"
                            app:cardBackgroundColor="@color/blbl_my_account_card_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:rippleColor="?attr/blblAccentWeak">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp">
                                <FrameLayout
                                    android:layout_width="52dp"
                                    android:layout_height="52dp">
                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/logo_tencent"
                                        android:layout_width="52dp"
                                        android:layout_height="52dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/ic_platform_add"
                                        android:contentDescription="@string/platform_tencent"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_Blbl_Circular" />
                                    <ImageView
                                        android:id="@+id/vip_tencent"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="bottom|end"
                                        android:src="@drawable/ic_vip_badge"
                                        android:contentDescription="@string/vip_badge_description"
                                        android:visibility="gone" />
                                </FrameLayout>
                                <TextView
                                    android:id="@+id/name_tencent"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/mango_account_logged_out"
                                    android:textColor="@color/blbl_my_account_primary"
                                    android:textSize="18sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/remove_tencent"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:nextFocusLeft="@id/account_tencent"
                            android:nextFocusUp="@id/remove_mango"
                            android:stateListAnimator="@animator/blbl_focus_scale"
                            app:cardBackgroundColor="@color/blbl_my_account_card_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:rippleColor="?attr/blblAccentWeak">
                            <ImageView
                                android:id="@+id/remove_tencent_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_platform_remove"
                                android:tint="?attr/blblDanger"
                                android:contentDescription="@string/account_logout_action" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_history"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="历史"
                    app:icon="@drawable/ic_nav_history" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_favorites"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="收藏"
                    app:icon="@drawable/ic_nav_favorite" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_watch_later"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="稍后再看"
                    app:icon="@drawable/ic_nav_watch_later" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bangumi"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="追番"
                    app:icon="@drawable/ic_nav_follow" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_drama"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="追剧"
                    app:icon="@drawable/ic_nav_drama" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_likes"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="最近点赞"
                    app:icon="@drawable/ic_nav_like" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/personal_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
