<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblContentBackground">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/overview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="28dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_account"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/blbl_focus_scale"
                app:cardBackgroundColor="@color/blbl_my_account_card_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:rippleColor="?attr/blblAccentWeak"
                app:strokeColor="?attr/blblFocusStrokeFocusOnlyColor"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_nav_my"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/account_avatar"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_Blbl_Circular" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/account_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/my_account_title"
                            android:textColor="@color/blbl_my_account_primary"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:id="@+id/account_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/blbl_my_action_content"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/account_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/action_manage_account"
                        android:textColor="@color/blbl_my_action_content"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />
                    <ImageView
                        android:id="@+id/account_arrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/blbl_my_action_content"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_mango_account"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/blbl_focus_scale"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="?attr/blblAccentWeak"
                app:strokeColor="?attr/blblFocusStrokeFocusOnlyColor"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/mango_account_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/mango_account_title"
                            android:textColor="?attr/blblOnPageBackdrop"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:id="@+id/mango_account_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/mango_account_logged_out"
                            android:textColor="?attr/blblOnPageBackdropSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/mango_account_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/mango_account_action_login"
                        android:textColor="?attr/blblOnPageBackdropSecondary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />
                    <ImageView
                        android:id="@+id/mango_account_arrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="?attr/blblOnPageBackdropSecondary"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_history"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="历史"
                    app:icon="@drawable/ic_nav_history" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_favorites"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="收藏"
                    app:icon="@drawable/ic_nav_favorite" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_watch_later"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="稍后再看"
                    app:icon="@drawable/ic_nav_watch_later" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bangumi"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="追番"
                    app:icon="@drawable/ic_nav_follow" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_drama"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="追剧"
                    app:icon="@drawable/ic_nav_drama" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_likes"
                    style="@style/Widget.Blbl.MyActionButton"
                    android:text="最近点赞"
                    app:icon="@drawable/ic_nav_like" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/personal_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
